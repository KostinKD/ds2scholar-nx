+void GameService::SupersedePlayerSessions(GameClient* Replacement)
+{
+    const RuntimeConfig& Config = ServerInstance->GetConfig();
+    const PlayerState& State = Replacement->GetPlayerState();
+    if (!Config.X360Mode || !Config.X360ReplacePlayerSessions ||
+        State.GetPlayerId() == 0 || State.GetSteamId().empty())
+    {
+        return;
+    }
+
+    // Called from a login handler during Clients iteration: do not erase here.
+    for (const auto& Client : Clients)
+    {
+        if (Client.get() == Replacement || Client->SessionSuperseded ||
+            Client->GetPlayerState().GetPlayerId() != State.GetPlayerId() ||
+            Client->GetPlayerState().GetSteamId() != State.GetSteamId())
+        {
+            continue;
+        }
+
+        Client->SessionSuperseded = true;
+        LogS(Client->GetName().c_str(), "[reconnect] Superseding old session for player %u; old age %.3fs, replacement age %.3fs.",
+            State.GetPlayerId(), Client->GetConnectionDuration(), Replacement->GetConnectionDuration());
+        Client->MessageStream->Disconnect();
+
+        // Clean up before the replacement can submit new signs or invasions.
+        // The ordinary Poll removal must not notify managers a second time.
+        Client->LostPlayerNotified = true;
+        for (const auto& Manager : Managers)
+        {
+            Manager->OnLostPlayer(Client.get());
+        }
+    }
+}
+
+std::vector<std::shared_ptr<GameClient>> GameService::GetClients()
+{
+    std::vector<std::shared_ptr<GameClient>> Result;
+    for (const auto& Client : Clients)
+    {
+        if (!Client->SessionSuperseded)
+        {
+            Result.push_back(Client);
+        }
+    }
+    return Result;
+}
